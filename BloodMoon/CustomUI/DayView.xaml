<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BloodMoon.CustomUI.DayView">
    <VerticalStackLayout>
        <Button 
            x:Name="DateBtn"
            Text="{Binding Text}"
            TextColor="Black"
            VerticalOptions="Center" 
            HorizontalOptions="Center"
            Margin="1"
            HeightRequest="45"
            Clicked="SelfClickHandler"
            BorderColor="Black"
            BorderWidth="1"/>
    </VerticalStackLayout>
</ContentView>
